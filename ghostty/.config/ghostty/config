macos-icon=xray

scrollback-limit = 1000000000

font-family = "MonoLisa"
font-family-bold = "MonoLisa"
font-family-italic = "MonoLisa"
font-family-bold-italic = "MonoLisa"
font-size = 10.5
font-thicken = true

keybind = super+shift+\=new_split:right
keybind = super+shift+-=new_split:down
keybind = super+shift+h=goto_split:left
keybind = super+shift+j=goto_split:down
keybind = super+shift+k=goto_split:up
keybind = super+shift+l=goto_split:right
keybind = super+shift+ctrl+h=resize_split:left,40
keybind = super+shift+ctrl+j=resize_split:down,40
keybind = super+shift+ctrl+k=resize_split:up,40
keybind = super+shift+ctrl+l=resize_split:right,40
keybind = super+shift+ctrl+==equalize_splits
keybind = global:super+shift+`=toggle_quick_terminal

mouse-hide-while-typing = true
cursor-opacity = 0.8
notify-on-command-finish = unfocused

foreground = #fafafa
background = #0a0a0a
background-opacity = 0.9
background-blur-radius = 20

window-padding-x = 6
window-padding-y = 6

# Pierre theme, dark variant, from chaosteil/pierre-theme.nvim.
# Two entries do not come from the pierre ansi block. The theme gives black and
# bright black the same color, thus dim text becomes invisible. Bright black
# uses fg.fg4 instead, and bright white uses fg.base.
palette = 0=#171717
palette = 1=#ff2e3f
palette = 2=#0dbe4e
palette = 3=#ffca00
palette = 4=#009fff
palette = 5=#e130ac
palette = 6=#08c0ef
palette = 7=#bcbcbc
palette = 8=#636363
palette = 9=#ff2e3f
palette = 10=#86c427
palette = 11=#ffca00
palette = 12=#009fff
palette = 13=#e130ac
palette = 14=#08c0ef
palette = 15=#fafafa

# The pierre roles for the parts that ghostty draws itself. The cursor uses the
# accent, the same as the editor cursor of the VS Code theme. The selection
# uses accent.subtle, the same as fish_color_selection.
# accent.primary
cursor-color = #009fff
# accent.contrastOnAccent
cursor-text = #0a0a0a
# accent.subtle
selection-background = #19283c
# fg.base
selection-foreground = #fafafa
# border.editor
split-divider-color = #1d1d1d
# bg.window
unfocused-split-fill = #171717

custom-shader=shaders/cursor_smear_fade.glsl
